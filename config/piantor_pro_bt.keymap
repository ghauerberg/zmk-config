 *
 * Piantor Pro BT keymap with OS-mode switching.
 * Layer 0-1: BASE_MAC / BASE_LINUX (ground layers)
 * Layer 2-3: NUM_MAC / NUM_LINUX
 * Layer 4-5: SYM_MAC / SYM_LINUX
 * Layer 6-7: NAV_MAC / NAV_LINUX
 * Layer 8-9: MOUSE_MAC / MOUSE_LINUX
 * Layer 10:  BT (Bluetooth profiles + OS toggle)
 *
 * MAC layers assume US layout on macOS.
 * LINUX layers assume Danish (nodeadkeys) layout on Fedora.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE_MAC    0
#define BASE_LINUX  1
#define NUM_MAC     2
#define NUM_LINUX   3
#define SYM_MAC     4
#define SYM_LINUX   5
#define NAV         6
#define NAV_LINUX   7
#define MOUSE_MAC   8
#define MOUSE_LINUX 9
#define BT          10

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_bt_layer {
            timeout-ms = <75>;
            key-positions = <12 17>;
            bindings = <&mo BT>;
            layers = <BASE_MAC BASE_LINUX>;
        };
    };
};

/ {
    behaviors {
        hrm_l: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hrm_r: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hrm_cp: home_row_mod_copypaste {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        td_quot: tap_dance_quot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SQT>, <&kp DQT>;
        };
        td_min: tap_dance_min {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&kp UNDER>;
        };
        td_slsh: tap_dance_slsh {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp FSLH>, <&kp BSLH>;
        };

        ht_quot: hold_tap_quot {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        ht_min: hold_tap_min {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        ht_slsh: hold_tap_slsh {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        ht_a: hold_tap_a {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        ht_e: hold_tap_e {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        ht_o: hold_tap_o {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        mm_sc: mod_morph_sc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(COMMA)>, <&kp LS(DOT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_fq: mod_morph_fq {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(MINUS)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        tmux_wp: tmux_wp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp LBKT>;
        };
        tmux_pp: tmux_pp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp P>;
        };
        tmux_nw: tmux_nw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp N>;
        };
        tmux_cw: tmux_cw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp C>;
        };
        tmux_sp: tmux_sp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp LS(N7)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  BASE_MAC (layer 0) — US layout on macOS                                      ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        base_mac_layer {
            display-name = "MAC";
            bindings = <
                &kp TAB       &kp Q        &kp W        &hrm_l LA(SQT) E &kp R    &kp T         &kp Y        &kp U        &kp I        &hrm_r LA(O) O &kp P      &kp BSPC
                &lt MOUSE_MAC ESC &hrm_l LA(A) A &hrm_l LALT S &hrm_l LCTRL D &hrm_l LGUI F &lt NAV G &kp H     &hrm_r RGUI J &hrm_r RCTRL K &hrm_r RALT L &kp SEMI  &kp RET
                &kp LGUI      &kp Z        &kp X        &hrm_cp LG(C) C &hrm_cp LG(V) V &kp B      &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp DEL
                                                          &kp LGUI     &mo NUM_MAC &kp LSHFT     &kp SPACE    &mo SYM_MAC &kp TAB
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  BASE_LINUX (layer 1) — Danish (nodeadkeys) layout on Fedora                   ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        base_linux_layer {
            display-name = "LNX";
            bindings = <
                &kp TAB       &kp Q        &kp W        &ht_e SEMI E     &kp R    &kp T         &kp Y        &kp U        &kp I        &ht_o SQT O     &kp P      &kp BSPC
                &lt MOUSE_LINUX ESC &ht_a LBKT A     &hrm_l LALT S &hrm_l LCTRL D &hrm_l LGUI F &lt NAV_LINUX G &kp H     &hrm_r RGUI J &hrm_r RCTRL K &hrm_r RALT L &mm_sc &kp RET
                &kp LCTRL     &kp Z        &kp X        &hrm_cp LG(C) C &hrm_cp LG(V) V &kp B      &kp N        &kp M        &kp COMMA    &kp DOT      &mm_fq     &kp DEL
                                                          &kp LCTRL    &mo NUM_LINUX &kp LSHFT     &kp SPACE    &mo SYM_LINUX &kp TAB
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  NUM_MAC (layer 2) — US layout                                                 ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        num_mac_layer {
            display-name = "NUM";
            bindings = <
                &kp DLLR     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5        &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp BSPC
                &kp QMARK    &td_slsh     &kp PRCNT    &kp AT       &kp COLON    &td_min       &kp PLUS     &kp LBRC     &kp LPAR     &kp RPAR     &kp RBRC     &kp EQUAL
                &kp PIPE     &kp EXCL     &kp HASH     &kp AMPS     &kp CARET    &kp TILDE     &td_quot     &kp LBKT     &kp RBKT     &kp GRAVE    &td_slsh     &trans
                                                        &kp LCTRL    &trans       &kp LSHFT     &kp LSHFT    &kp TILDE    &kp GRAVE
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  NUM_LINUX (layer 3) — Danish (nodeadkeys)                                     ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        num_linux_layer {
            display-name = "NUM";
            bindings = <
                &kp RA(N4)    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5        &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp BSPC
                &kp LS(MINUS) &ht_slsh NUBS LS(N7)     &kp PRCNT    &kp RA(N2)   &kp LS(DOT)  &ht_min LS(FSLH) FSLH     &kp MINUS    &kp RA(N7)   &kp LS(N8)   &kp LS(N9)   &kp RA(N0)   &kp LS(N0)
                &kp RA(EQUAL) &kp EXCL    &kp HASH     &kp LS(N6)   &kp LS(RBKT) &kp RA(RBKT)  &ht_quot LS(N2) BSLH     &kp RA(N8)   &kp RA(N9)   &kp LS(EQUAL) &ht_slsh NUBS LS(N7)     &trans
                                                          &kp LCTRL    &trans       &kp LSHFT     &kp LSHFT    &kp RA(RBKT) &kp LS(EQUAL)
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  SYM_MAC (layer 4) — US layout                                                 ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        sym_mac_layer {
            display-name = "SYM";
            bindings = <
                &kp TAB      &kp EXCL        &kp AT          &kp HASH     &kp DLLR     &kp PRCNT     &kp PG_UP    &kp PG_DN    &kp PG_UP    &kp HOME     &kp END      &kp BSPC
                &kp LCTRL    &kp LG(LS(N4))  &kp LG(LS(N3))  &none        &kp LGUI     &none         &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp ESC      &kp GRAVE
                &kp LSHFT    &none           &none           &none        &none        &kp LC(B)     &kp RC(R)    &kp RC(W)    &kp LA(H)    &kp LA(L)    &kp PIPE     &kp TILDE
                                                              &kp LALT     &kp LCTRL    &kp LSHFT     &trans       &none        &trans
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  SYM_LINUX (layer 5) — Danish (nodeadkeys)                                     ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        sym_linux_layer {
            display-name = "SYM";
            bindings = <
                &kp TAB      &kp EXCL        &kp RA(N2)       &kp HASH     &kp RA(N4)     &kp PRCNT     &kp PG_UP    &kp PG_DN    &kp PG_UP    &kp HOME     &kp END      &kp BSPC
                &kp LCTRL    &kp LG(LS(N4))  &kp LG(LS(N3))  &none        &kp LGUI     &none         &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp ESC      &kp LS(EQUAL)
                &kp LSHFT    &none           &none           &none        &none        &kp LC(B)     &kp RC(R)    &kp RC(W)    &kp LA(H)    &kp LA(L)    &kp RA(EQUAL) &kp RA(RBKT)
                                                               &kp LALT     &kp LCTRL    &kp LSHFT     &trans       &none        &trans
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  NAV_MAC (layer 6) — macOS shortcuts, momentary via &lt NAV G                  ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        nav_mac_layer {
            display-name = "NAV";
            bindings = <
                &none        &none        &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(BSPC) &bt BT_CLR    &tmux_wp     &kp LC(B)    &none        &none        &none        &none
                &none        &kp BSPC     &kp LG(LS(TAB))    &kp LG(TAB)        &kp ESC      &trans        &tmux_pp     &tmux_nw     &none        &none        &none        &none
                &none        &kp ESC      &kp C_VOL_DN   &kp C_VOL_UP   &none        &none         &tmux_cw     &none        &none        &none        &none        &none
                                                           &kp LALT      &kp SPACE    &kp LGUI      &kp LGUI     &kp SPACE    &kp LALT
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  NAV_LINUX (layer 10) — Linux keycodes, momentary via &lt NAV_LINUX G          ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        nav_linux_layer {
            display-name = "NAV";
            bindings = <
                &none        &none        &kp PRINTSCREEN &kp LG(LS(N4)) &kp LG(BSPC) &bt BT_CLR    &tmux_wp     &kp LC(B)    &none        &none        &none        &none
                &none        &kp BSPC     &kp LG(LS(TAB))    &kp LG(TAB)        &kp ESC      &trans        &tmux_pp     &tmux_nw     &none        &none        &none        &none
                &none        &kp ESC      &kp C_VOL_DN   &kp C_VOL_UP   &none        &none         &tmux_cw     &none        &none        &none        &none        &none
                                                           &kp LALT      &kp SPACE    &kp LGUI      &kp LGUI     &kp SPACE    &kp LALT
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  MOUSE_MAC (layer 7) — macOS Cmd+C/V                                           ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        mouse_mac_layer {
            display-name = "MSE";
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans        &trans            &trans            &msc SCRL_UP      &msc SCRL_DOWN    &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans        &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP      &mmv MOVE_RIGHT   &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans        &trans            &kp LG(LA(LEFT))  &kp LG(LA(RIGHT)) &none             &trans       &trans
                                                        &kp LG(V)    &kp LG(C)    &kp LSHFT     &mkp LCLK         &mkp RCLK         &to BASE_MAC
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  MOUSE_LINUX (layer 8) — Linux Ctrl+C/V                                        ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        mouse_linux_layer {
            display-name = "MSE";
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans        &trans            &trans            &msc SCRL_UP      &msc SCRL_DOWN    &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans        &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP      &mmv MOVE_RIGHT   &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans        &trans            &kp LG(LA(LEFT))  &kp LG(LA(RIGHT)) &none             &trans       &trans
                                                        &kp LC(V)    &kp LC(C)    &kp LSHFT     &mkp LCLK         &mkp RCLK         &to BASE_LINUX
            >;
        };

        // ╔══════════════════════════════════════════════════════════════════════════════════╗
        // ║  BT (layer 9) — Bluetooth profiles + OS toggle                                 ║
        // ╚══════════════════════════════════════════════════════════════════════════════════╝
        bt_layer {
            display-name = "BT";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans       &trans       &trans       &trans       &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans
                &trans &trans &trans &trans &trans &trans  &trans       &trans       &trans       &trans       &trans &trans
                                     &trans &to BASE_LINUX &to BASE_MAC  &trans       &trans &trans
            >;
        };
    };
};
